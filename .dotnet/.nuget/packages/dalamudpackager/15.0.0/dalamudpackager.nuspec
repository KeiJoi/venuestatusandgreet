<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>DalamudPackager</id>
    <version>15.0.0</version>
    <title>DalamudPackager</title>
    <authors>Anna Clemens, goatcorp contributors</authors>
    <license type="expression">EUPL-1.2</license>
    <licenseUrl>https://licenses.nuget.org/EUPL-1.2</licenseUrl>
    <projectUrl>https://github.com/goatcorp/DalamudPackager</projectUrl>
    <description>An MSBuild task that simplifies making Dalamud plugins by generating a manifest and packing the build output into a release-ready zip.</description>
    <repository type="git" url="https://github.com/goatcorp/DalamudPackager" commit="827d88dca94996aebfbcbd35cfb371f9813bb82f" />
    <dependencies>
      <group targetFramework=".NETFramework4.8" />
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.IO.Compression" targetFramework=".NETFramework4.8" />
    </frameworkAssemblies>
  </metadata>
</package>